<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Name="LauncherWindow"
    Title="ComfyUI 桌面版"
    Width="1280"
    Height="720"
    MinWidth="980"
    MinHeight="650"
    WindowState="Normal"
    WindowStartupLocation="CenterScreen"
    Background="#080D12"
    Foreground="#F3F6F8"
    FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
    FontSize="14"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>
        <sys:String x:Key="StatusReady">准备就绪</sys:String>
        <sys:String x:Key="StatusStarting">正在启动 · 端口 {0}</sys:String>
        <sys:String x:Key="StatusRunning">运行中 · http://127.0.0.1:{0}</sys:String>
        <sys:String x:Key="StatusStopping">正在停止…</sys:String>
        <sys:String x:Key="StatusStopped">已停止</sys:String>
        <sys:String x:Key="StatusExited">进程已退出 · 代码 {0}</sys:String>
        <sys:String x:Key="StatusFailed">启动失败</sys:String>
        <sys:String x:Key="StatusPortBusy">端口 {0} 已被占用</sys:String>
        <sys:String x:Key="StatusTempCleaned">运行临时内容已清理</sys:String>
        <sys:String x:Key="GpuUnavailable">未检测到 NVIDIA 显卡信息</sys:String>
        <sys:String x:Key="InvalidPort">请输入 1024 到 65535 之间的端口。</sys:String>
        <sys:String x:Key="PortBusyMessage">端口 {0} 已被其他程序占用。请更换端口，或先关闭占用程序。</sys:String>
        <sys:String x:Key="StartFailedMessage">无法启动 ComfyUI：{0}</sys:String>
        <sys:String x:Key="ConfirmTempClean">确定要立即清空运行临时目录 temp 吗？input 和 output 不会被处理。</sys:String>
        <sys:String x:Key="ConfirmExit">ComfyUI 仍在运行。是否停止进程并退出启动器？</sys:String>
        <sys:String x:Key="DialogTitle">ComfyUI 桌面版</sys:String>
        <sys:String x:Key="LogReady">启动器已就绪。本次会话日志将在退出后清除。</sys:String>
        <sys:String x:Key="LogStarting">正在启动 ComfyUI：{0}</sys:String>
        <sys:String x:Key="LogRunning">服务已就绪：{0}</sys:String>
        <sys:String x:Key="LogStopping">正在停止 ComfyUI 进程…</sys:String>
        <sys:String x:Key="LogTempCleaned">运行临时目录已清理，输入与生成结果已保留。</sys:String>

        <SolidColorBrush x:Key="PanelBrush" Color="#10171F"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#151F29"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#22313D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#82909E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E8FF42"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#5C74FF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B7A"/>

        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="Background" Value="#202B37"/>
            <Setter Property="BorderBrush" Value="#334252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#536475"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9EABBA"/>
            <Setter Property="Padding" Value="17,12"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FolderButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#141E27"/>
            <Setter Property="BorderBrush" Value="#263744"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Background" Value="#101820"/>
            <Setter Property="BorderBrush" Value="#21313D"/>
            <Setter Property="Foreground" Value="#8795A2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ExtensionDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111B24"/>
            <Setter Property="Foreground" Value="#A9B6C1"/>
            <Setter Property="BorderBrush" Value="#22313D"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ExtensionDataGridCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#DCE4EA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1B2B37"/>
                    <Setter Property="Foreground" Value="#F7F9FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExtensionDataGridText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ExtensionDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#0D151C"/>
            <Setter Property="BorderBrush" Value="#1C2A34"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#101922"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15222C"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1B2B37"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExtensionDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#0B1218"/>
            <Setter Property="Foreground" Value="#DCE4EA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ExtensionDataGridHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource ExtensionDataGridCell}"/>
            <Setter Property="RowStyle" Value="{StaticResource ExtensionDataGridRow}"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>

        <Style x:Key="ShowcaseArrowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#17222C"/>
            <Setter Property="BorderBrush" Value="#2E414F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ArrowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowBorder" Property="Background" Value="#1D2B36"/>
                                <Setter TargetName="ArrowBorder" Property="BorderBrush" Value="#536B7C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ArrowBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F7FA"/>
            <Setter Property="Background" Value="#0C131A"/>
            <Setter Property="BorderBrush" Value="#2A3B49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CaretBrush" Value="#E8FF42"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#27323B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Grid>
                            <Border
                                x:Name="SelectionRail"
                                Width="2"
                                Height="16"
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                CornerRadius="1"/>
                            <Border
                                x:Name="ItemBorder"
                                Margin="6,0,0,0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E9EEF2"/>
                                <Setter Property="Foreground" Value="#111820"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E2E8ED"/>
                                <Setter TargetName="SelectionRail" Property="Background" Value="#5068EA"/>
                                <Setter Property="Foreground" Value="#111820"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="Background" Value="#F5F7F8"/>
            <Setter Property="BorderBrush" Value="#C7D0D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0,8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                x:Name="DropDownToggle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Focusable="False"
                                ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="SelectorBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Margin="12,0,8,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Foreground="#111820"
                                                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                    Text="{Binding SelectedItem.Content, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>
                                                <Path
                                                    x:Name="Arrow"
                                                    Grid.Column="1"
                                                    Width="8"
                                                    Height="4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 4 4 L 8 0"
                                                    Stroke="#5B6872"
                                                    StrokeThickness="1.35"
                                                    StrokeStartLineCap="Round"
                                                    StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectorBorder" Property="Background" Value="#FFFFFF"/>
                                                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#9EABB5"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#26323B"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="SelectorBorder" Property="Background" Value="#FFFFFF"/>
                                                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#7182D8"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#354BB7"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="SelectorBorder" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                PopupAnimation="Fade">
                                <Grid
                                    x:Name="DropDown"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,6,0,0">
                                    <Border
                                        Background="#F7F9FA"
                                        BorderBrush="#C6CFD6"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4">
                                        <ScrollViewer
                                            CanContentScroll="True"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDown" Property="MinHeight" Value="44"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6D7A85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE3EA"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="198"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0C1218" BorderBrush="#1D2A34" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="WORKSPACE" Foreground="#566573" FontSize="10" FontWeight="Bold" Margin="27,0,0,10"/>
                        <Button x:Name="NavHome" Style="{StaticResource NavButton}" Content="01   首页"/>
                        <Button x:Name="NavAdvanced" Style="{StaticResource NavButton}" Content="02   高级选项"/>
                        <Button x:Name="NavNetwork" Style="{StaticResource NavButton}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="03   维护中心" VerticalAlignment="Center"/>
                                <Border x:Name="UpdateNavBadge" Grid.Column="1" Background="#E8FF42" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                    <TextBlock Text="新版本" Foreground="#10150D" FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="NavFolders" Style="{StaticResource NavButton}" Content="04   常用文件夹"/>
                        <Button x:Name="NavConsole" Style="{StaticResource NavButton}" Content="05   控制台"/>
                    </StackPanel>

                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="22">
                <Grid x:Name="PageHome">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="HeroCard"
                        Background="#111827"
                        CornerRadius="22"
                        ClipToBounds="True"
                        BorderThickness="1">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#73859CEB" Offset="0"/>
                                <GradientStop Color="#5C526EAC" Offset="0.52"/>
                                <GradientStop Color="#39404B62" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect Color="#263E76" BlurRadius="22" ShadowDepth="7" Opacity="0.36"/>
                        </Border.Effect>
                        <Grid x:Name="HeroVisualHost" Background="#111827">
                            <Image
                                x:Name="HeroPoster"
                                Stretch="UniformToFill"
                                Margin="-38,0,0,0"
                                IsHitTestVisible="False"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Rectangle
                                Width="170"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#C7CFDA" Offset="0"/>
                                        <GradientStop Color="#C5CED9" Offset="0.42"/>
                                        <GradientStop Color="#00C5CED9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D20B1522" Offset="0"/>
                                        <GradientStop Color="#880E1A2A" Offset="0.34"/>
                                        <GradientStop Color="#34101928" Offset="0.58"/>
                                        <GradientStop Color="#08101928" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Fill="#04050A12" IsHitTestVisible="False"/>
                            <Border
                                Margin="1"
                                CornerRadius="21"
                                BorderThickness="1"
                                IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#5AFFFFFF" Offset="0"/>
                                        <GradientStop Color="#0FFFFFFF" Offset="0.32"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.58"/>
                                        <GradientStop Color="#384E67D8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <Rectangle
                                Height="1"
                                Margin="30,0"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#72FFFFFF" Offset="0.24"/>
                                        <GradientStop Color="#2FFFFFFF" Offset="0.64"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid Margin="32,26">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#E8FF42" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="COMFYUI  /  LOCAL WORKSPACE" FontSize="10.5" FontWeight="Bold" Foreground="#D6DEFF"/>
                                    </StackPanel>
                                    <TextBlock Text="筑梦启动器" FontSize="33" FontWeight="SemiBold" Margin="0,6,0,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#060A12" BlurRadius="10" ShadowDepth="1" Opacity="0.52"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="一个入口，跑遍所有生成工作流" Foreground="#E0E7F0" FontSize="13" Margin="0,8,0,18"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnStart" Style="{StaticResource RoundedButton}" Content="启动 ComfyUI" Width="158" Height="46" Background="#E8FF42" Foreground="#10150D" BorderBrush="#F2FF8A" FontSize="15">
                                            <Button.Effect>
                                                <DropShadowEffect Color="#B9D82A" BlurRadius="15" ShadowDepth="0" Opacity="0.34"/>
                                            </Button.Effect>
                                        </Button>
                                        <Button x:Name="BtnStop" Style="{StaticResource RoundedButton}" Content="停止" Width="88" Height="46" Margin="10,0,0,0" Background="#263443" IsEnabled="False"/>
                                        <Button x:Name="BtnRestart" Style="{StaticResource RoundedButton}" Content="重启" Width="88" Height="46" Margin="10,0,0,0" Background="#263443" IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border
                                x:Name="TopStatusPill"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,20,22,0"
                                Padding="9,5"
                                Background="#73101720"
                                BorderBrush="#6B7D8FAB"
                                BorderThickness="1"
                                CornerRadius="13"
                                IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="#05080D" BlurRadius="12" ShadowDepth="3" Opacity="0.38"/>
