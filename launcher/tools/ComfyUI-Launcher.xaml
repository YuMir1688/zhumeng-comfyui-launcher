                                            <TextBlock x:Name="HfTestStatusText" Grid.Column="1" Text="未检测" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                                            <Button x:Name="BtnTestHf" Grid.Column="2" Style="{StaticResource CompactButton}" Content="测试"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#0D151C" BorderBrush="#1E2D38" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="74"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="GitHub" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="GithubTestStatusText" Grid.Column="1" Text="未检测" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                                            <Button x:Name="BtnTestGithub" Grid.Column="2" Style="{StaticResource CompactButton}" Content="测试"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#0D151C" BorderBrush="#1E2D38" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,0,0,8">
