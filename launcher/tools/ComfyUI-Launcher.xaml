                                <TextBlock Grid.Column="2" Text="更新通道" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <ComboBox x:Name="UpdateChannelCombo" Grid.Column="3" Height="34">
