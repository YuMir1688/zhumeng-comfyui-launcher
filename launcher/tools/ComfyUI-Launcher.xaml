                                <StackPanel>
                                    <TextBlock Text="安装扩展" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="从 ComfyUI-Manager 公开目录查找 GitHub 扩展；安装前请核验来源。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button
                                    x:Name="BtnRefreshExtensionCatalog"
                                    Grid.Column="1"
                                    Style="{StaticResource CompactButton}"
                                    Content="刷新目录"
                                    Width="88"
                                    VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="搜索" Foreground="#9BA9B4" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox
                                        x:Name="ExtensionCatalogSearchBox"
                                        Grid.Column="1"
                                        Height="36"
                                        Padding="11,7"
                                        ToolTip="按扩展名称、简介或来源搜索"/>
                                </Grid>
                                <Border Grid.Row="2" Background="#0B1218" BorderBrush="#22313D" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                    <DataGrid
                                        x:Name="ExtensionCatalogGrid"
                                        Style="{StaticResource ExtensionDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="扩展名称" Binding="{Binding DisplayName}" ElementStyle="{StaticResource ExtensionDataGridText}" Width="1.35*" MinWidth="150"/>
                                            <DataGridTextColumn Header="简介" Binding="{Binding Description}" ElementStyle="{StaticResource ExtensionDataGridText}" Width="2.2*" MinWidth="250"/>
                                            <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" ElementStyle="{StaticResource ExtensionDataGridText}" Width="1.05*" MinWidth="125"/>
                                            <DataGridTemplateColumn Header="状态" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            x:Name="ExtensionStateBadge"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Padding="8,3"
                                                            Background="#11281E"
                                                            BorderBrush="#285B3D"
                                                            BorderThickness="1"
                                                            CornerRadius="10">
                                                            <TextBlock
                                                                x:Name="ExtensionStateText"
                                                                Text="{Binding StateText}"
                                                                Foreground="#64E89A"
                                                                FontSize="10"
                                                                FontWeight="SemiBold"/>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding StateText}" Value="已存在">
                                                                <Setter TargetName="ExtensionStateBadge" Property="Background" Value="#152436"/>
                                                                <Setter TargetName="ExtensionStateBadge" Property="BorderBrush" Value="#31506B"/>
                                                                <Setter TargetName="ExtensionStateText" Property="Foreground" Value="#8FC8F2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateText}" Value="可重新安装">
                                                                <Setter TargetName="ExtensionStateBadge" Property="Background" Value="#2A2110"/>
                                                                <Setter TargetName="ExtensionStateBadge" Property="BorderBrush" Value="#6B5422"/>
                                                                <Setter TargetName="ExtensionStateText" Property="Foreground" Value="#FFD36A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateText}" Value="需要处理">
                                                                <Setter TargetName="ExtensionStateBadge" Property="Background" Value="#2B171A"/>
                                                                <Setter TargetName="ExtensionStateBadge" Property="BorderBrush" Value="#71343B"/>
                                                                <Setter TargetName="ExtensionStateText" Property="Foreground" Value="#FF8D99"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="ExtensionCatalogStatusText"
                                        Text="尚未加载扩展目录。"
                                        Foreground="#788895"
                                        FontSize="10"
                                        TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar
                                        x:Name="ExtensionCatalogProgress"
                                        Height="3"
                                        Margin="0,7,18,0"
                                        IsIndeterminate="True"
                                        Visibility="Collapsed"
                                        Foreground="#6F85FF"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnOpenExtensionSource" Style="{StaticResource CompactButton}" Content="打开来源" Width="82" IsEnabled="False"/>
                                    <Button x:Name="BtnInstallSelectedExtension" Style="{StaticResource CompactButton}" Content="安装" Width="88" Margin="8,0,0,0" IsEnabled="False" Background="#5068EA" BorderBrush="#667BFF"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="PageFolders" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="常用文件夹" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="快速打开整合包中的常用位置。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="24,24,10,10" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="BtnFolderRoot" Grid.Row="0" Grid.Column="0" Style="{StaticResource FolderButton}" Content="整合包根目录"/>
                            <Button x:Name="BtnFolderModels" Grid.Row="0" Grid.Column="1" Style="{StaticResource FolderButton}" Content="模型 · models"/>
                            <Button x:Name="BtnFolderNodes" Grid.Row="0" Grid.Column="2" Style="{StaticResource FolderButton}" Content="自定义节点 · custom_nodes"/>
                            <Button x:Name="BtnFolderInput" Grid.Row="1" Grid.Column="0" Style="{StaticResource FolderButton}" Content="输入 · input"/>
                            <Button x:Name="BtnFolderOutput" Grid.Row="1" Grid.Column="1" Style="{StaticResource FolderButton}" Content="输出 · output"/>
                            <Button x:Name="BtnFolderUser" Grid.Row="1" Grid.Column="2" Style="{StaticResource FolderButton}" Content="用户数据 · user"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="PageConsole" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="控制台" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="实时显示当前会话日志；退出启动器后不会保留。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnConsoleOpenWeb" Style="{StaticResource RoundedButton}" Content="打开 ComfyUI" IsEnabled="False" Margin="0,0,10,0"/>
                            <Button x:Name="BtnExportRunLog" Style="{StaticResource RoundedButton}" Content="导出运行日志"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="#060A0E" BorderBrush="#22313D" BorderThickness="1" CornerRadius="18" Padding="4">
                        <TextBox
                            x:Name="ConsoleBox"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="13"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="14"
                            Foreground="#C8D2DC"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="#0C1218" BorderBrush="#1D2A34" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BottomStatusText" Text="准备就绪" VerticalAlignment="Center" Foreground="#8D9AA6" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="LOCAL  ·  127.0.0.1" VerticalAlignment="Center" Foreground="#566573" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</Window>
