                                        <Button x:Name="BtnInventoryScan" Style="{StaticResource CompactButton}" Content="修复整合包" Width="124" IsEnabled="False"/>
                                        <Button x:Name="BtnCancelInventory" Grid.Column="1" Style="{StaticResource CompactButton}" Content="取消" Width="64" Margin="8,0,0,0" Visibility="Collapsed"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="会改动内置 Python · 失败自动回滚"
                                            Foreground="#62717D"
                                            FontSize="9.5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
