                                    <ComboBoxItem Content="已启用" Tag="enabled"/>
                                    <ComboBoxItem Content="已停用" Tag="disabled"/>
                                    <ComboBoxItem Content="已移除备份" Tag="recoverable"/>
                                    <ComboBoxItem Content="需要处理" Tag="attention"/>
                                </ComboBox>
