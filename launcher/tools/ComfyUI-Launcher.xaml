                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="最新版本" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="CoreLatestVersionText" Grid.Column="1" Text="尚未检查" FontWeight="SemiBold"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="更新时间" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="CorePublishedText" Grid.Column="1" Text="—"/>
                                            </Grid>
                                            <TextBlock x:Name="CoreUpdateStatusText" Text="点击“检查更新”获取官方版本信息。" Foreground="#AAB5BE" FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#0B1117" BorderBrush="#1D2A34" BorderThickness="1" CornerRadius="12" Padding="12" Margin="16,0,0,0">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="CoreReleaseNotesText" Text="更新说明将在检查后显示。" Foreground="#85939F" FontSize="11" TextWrapping="Wrap" LineHeight="18"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="3" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnOpenCoreRelease" Style="{StaticResource CompactButton}" Content="查看更新说明" IsEnabled="False" Width="108"/>
                                        <Button x:Name="BtnIgnoreCoreVersion" Grid.Column="1" Style="{StaticResource CompactButton}" Content="忽略此版本" IsEnabled="False" Width="98" Margin="8,0,0,0"/>
                                        <Button x:Name="BtnInstallCoreUpdate" Grid.Column="3" Style="{StaticResource CompactButton}" Content="立即更新" IsEnabled="False" Width="116" Background="#5068EA" BorderBrush="#667BFF"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border
                        x:Name="ExtensionsPanel"
                        Grid.Row="4"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
