                                    <Button x:Name="BtnCopyNetworkDiagnostics" Grid.Column="1" Style="{StaticResource CompactButton}" Content="复制诊断信息" Width="112"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="UpdatePanel" Grid.Row="4" Visibility="Collapsed">
